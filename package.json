{
  "name": "joker-phone-pos-system",
  "version": "2.0.0",
  "description": "الجوكر فون - JOKER PHONE — نظام إدارة محلات التليفونات والاكسسوارات والصيانة",
  "main": "dist-electron/main/index.js",
  "author": "Joker Phone Team",
  "license": "UNLICENSED",
  "private": true,
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "dist": "tsc && vite build && electron-builder",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "node run-tests.js",
    "test:unit": "node run-tests.js tests/unit",
    "test:integration": "node run-tests.js tests/integration"
  },
  "dependencies": {
    "better-sqlite3": "^11.8.1",
    "jsbarcode": "^3.12.3",
    "lucide-react": "^1.16.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.12",
    "@types/jsbarcode": "^3.11.4",
    "@types/node": "^22.13.5",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "^34.2.0",
    "electron-builder": "^25.1.8",
    "typescript": "^5.7.3",
    "vite": "^6.2.0",
    "vite-plugin-electron": "^0.29.0",
    "vite-plugin-electron-renderer": "^0.14.6",
    "vitest": "^5.0.3"
  },
  "build": {
    "appId": "com.jokerphone.pos",
    "productName": "الجوكر فون - JOKER PHONE",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "build/**/*",
      "public/**/*"
    ],
    "win": {
      "icon": "build/icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "الجوكر فون - JOKER PHONE",
      "installerIcon": "build/installerIcon.ico",
      "uninstallerIcon": "build/uninstallerIcon.ico",
      "installerHeaderIcon": "build/installerIcon.ico"
    }
  }
}
